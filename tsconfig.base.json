{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@hashmug/core": ["./packages/core/src/index.ts"],
      "@hashmug/core/internal": ["./packages/core/src/internal.ts"],
      "@hashmug/png": ["./packages/png/src/index.ts"]
    }
  }
}
