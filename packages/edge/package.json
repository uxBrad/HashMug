{
  "name": "@hashmug/edge",
  "version": "0.1.0",
  "description": "HTTP avatar endpoint (Hono). Runs on Cloudflare Workers, Node, Deno, Bun.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "files": [
    "dist",
    "wrangler.toml"
  ],
  "scripts": {
    "build": "tsup",
    "start": "node dist/node.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hashmug/core": "workspace:*",
    "@hashmug/png": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "author": "Brad Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxBrad/HashMug.git",
    "directory": "packages/edge"
  },
  "homepage": "https://github.com/uxBrad/HashMug#readme",
  "bugs": {
    "url": "https://github.com/uxBrad/HashMug/issues"
  },
  "keywords": [
    "avatar",
    "identicon",
    "hash",
    "deterministic",
    "svg",
    "wallet",
    "ethereum"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
