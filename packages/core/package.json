{
  "name": "@hashmug/core",
  "version": "0.1.0",
  "description": "Deterministic identicon and avatar generator. Zero dependencies, SVG output.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "author": "Brad Cooper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxBrad/HashMug.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/uxBrad/HashMug#readme",
  "bugs": {
    "url": "https://github.com/uxBrad/HashMug/issues"
  },
  "keywords": [
    "avatar",
    "identicon",
    "hash",
    "deterministic",
    "svg",
    "wallet",
    "ethereum"
  ],
  "publishConfig": {
    "access": "public"
  }
}
